<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Portal | En İyi Yapay Zekâ Araçları (2026)</title>
<meta name="description" content="AI Portal ile resim, video ve ses üreten en iyi yapay zekâ araçlarını keşfet. Ücretsiz ve ücretli AI listeleri tek bir yerde.">
<link rel="stylesheet" href="style.css">
</head>
<body>

<h1 data-i18n="title">🤖 AI Portal</h1>
<p data-i18n="subtitle">En iyi yapay zekâ araçlarını tek yerde keşfet</p>

<input 
  type="text"
  id="globalSearch"
  data-i18n-placeholder="searchPlaceholder"
  placeholder="🔍 Tüm yapay zekâlarda ara..."
  onkeyup="globalSearchAI()"
  style="padding:12px; width:340px; border-radius:10px; border:none; margin:20px;"
>

<div id="searchResults" class="menu"></div>

<div class="menu home-menu">
  <a href="images.html" class="home-card">
    <div class="icon">🖼️</div>
    <div class="text">
      <h2 data-i18n="imageAI">Resim Yapan AI’lar</h2>
      <p data-i18n="imageAIDesc">Metinden görsel üreten yapay zekâ araçları</p>
    </div>
  </a>

  <a href="video.html" class="home-card">
    <div class="icon">🎬</div>
    <div class="text">
      <h2 data-i18n="videoAI">Video Yapan AI’lar</h2>
      <p data-i18n="videoAIDesc">Metin ve görselden video oluşturan AI’lar</p>
    </div>
  </a>

  <a href="audio.html" class="home-card">
    <div class="icon">🎧</div>
    <div class="text">
      <h2 data-i18n="audioAI">Ses Yapan AI’lar</h2>
      <p data-i18n="audioAIDesc">Konuşma, seslendirme ve müzik üreten yapay zekâlar</p>
    </div>
  </a>

  <a href="text.html" class="home-card">
    <div class="icon">✍️</div>
    <div class="text">
      <h2 data-i18n="textAI">Metin Yazan AI’lar</h2>
      <p data-i18n="textAIDesc">Blog, makale ve içerik üreten yapay zekâlar</p>
    </div>
  </a>

  <a href="best.html" class="home-card">
    <div class="icon">🏆</div>
    <div class="text">
      <h2 data-i18n="bestAI">Best AI Tools</h2>
      <p data-i18n="bestAIDesc">2026’nın en iyi yapay zekâ araçları</p>
    </div>
  </a>
</div>

<button id="themeToggle" onclick="toggleTheme()">
  <span id="themeIcon">🌙</span>
  <span id="themeText">Dark</span>
</button>

<button id="langToggle" onclick="toggleLang()">
  <span class="globe">🌍</span>
  <span id="langText">TR</span>
</button>

<div class="mobile-nav">
  <a href="index.html">🏠<span data-i18n="navHome">Ana</span></a>
  <a href="images.html">🖼️<span data-i18n="navImage">Resim</span></a>
  <a href="video.html">🎬<span data-i18n="navVideo">Video</span></a>
</div>

<script src="translation.js"></script>
<script src="script.js"></script>

</body>
</html>